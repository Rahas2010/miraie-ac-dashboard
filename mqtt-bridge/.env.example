# MirAIe MQTT Bridge Environment Variables

# Required: Your MirAIe credentials
MIRAIE_USER_ID=your_email@example.com
MIRAIE_PASSWORD=your_password

# Optional: WebSocket server port (default: 3001)
WS_PORT=3001

# Optional: CORS origin for WebSocket connections
# Set this to your Vercel app URL in production
CORS_ORIGIN=*
