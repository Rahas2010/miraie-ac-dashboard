# Panasonic MirAIe Credentials
# Use your MirAIe app login credentials
MIRAIE_USER_ID=your_email@example.com
MIRAIE_PASSWORD=your_password

# MQTT Bridge URL (for hybrid mode with real-time updates)
# Deploy the mqtt-bridge service and set this URL
NEXT_PUBLIC_MQTT_BRIDGE_URL=ws://localhost:3001

# Optional: Enable voice commands
NEXT_PUBLIC_VOICE_ENABLED=true

# Optional: App name displayed in the dashboard
NEXT_PUBLIC_APP_NAME=My AC Dashboard
